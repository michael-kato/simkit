<?xml version="1.0"?>
<!--
  Placeholder differential-drive robot with an RGB-D camera.
  This URDF is the single source of truth for the robot body. Engine formats
  are generated from it; never hand-edit the outputs.
  Frame names here must match interfaces/ros2_contract.yaml.
-->
<robot name="simkit_bot">

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.50 0.40 0.20"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.50 0.40 0.20"/></geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.25" ixy="0" ixz="0" iyy="0.36" iyz="0" izz="0.51"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0027" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.23 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0027" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.23 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Camera body frame: x forward (ROS convention). -->
  <link name="front_camera_link">
    <visual>
      <geometry><box size="0.03 0.09 0.025"/></geometry>
    </visual>
  </link>

  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0.24 0 0.35" rpy="0 0.0873 0"/>
  </joint>

  <!-- Optical frame: z forward, x right, y down. Images are expressed here. -->
  <link name="front_camera_optical_frame"/>

  <joint name="front_camera_optical_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="front_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

</robot>
